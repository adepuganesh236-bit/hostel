# -----------------------------------------------------------------------------
# Django REST backend (backend/.env.example)
# Copy this file to backend/.env and fill in your values. Never commit .env.
# -----------------------------------------------------------------------------

# -- MySQL (Django authentication database) -----------------------------------
DB_NAME=Hostel
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# -- Django security ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- Frontend URL (used to build the password reset link inside emails) -------
FRONTEND_URL=http://localhost:5173

# -- Email (Django SMTP backend) ----------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# -- JWT ----------------------------------------------------------------------
JWT_SIGNING_KEY=your_jwt_signing_secret
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7