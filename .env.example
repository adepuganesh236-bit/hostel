# -- Frontend (Vite) ---------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Point this at your Express API server when using MySQL.
# Leave blank to fall back to Supabase (if keys above are set) or demo mode.
VITE_API_URL=

# -- MySQL (used by server/) -------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=staynest

# -- Server -------------------------------------------------------------
PORT=4000

# -- Seed credentials (auto-applied on server start if missing) ----------
ADMIN_EMAIL=admin@staynest.in
ADMIN_PASSWORD=admin123