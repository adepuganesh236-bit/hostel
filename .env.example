# -- Frontend (Vite) ---------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Point this at your running API backend.
# Express/MySQL backend: http://localhost:4000  (server/ — `npm run server`)
# Leave blank to fall back to Supabase (if keys above are set) or demo mode.
VITE_API_URL=http://localhost:4000

# -- MySQL (used by server/ Express API) --------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=staynest

# -- Server -------------------------------------------------------------
PORT=4000

# -- Seed credentials (auto-applied on server start if missing) ----------
ADMIN_EMAIL=admin@staynest.in
ADMIN_PASSWORD=admin123

# -- Email (password reset OTP via nodemailer) ----------------------------
# Gmail (recommended):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=465            # implicit TLS (EMAIL_SECURE=true)
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=<16-char Gmail App Password>  (2FA required, not your login password)
# Gmail on port 587 (STARTTLS) instead: EMAIL_PORT=587 / EMAIL_SECURE=false / EMAIL_REQUIRE_TLS=true
# Local/dev alternative (no real account): run a local SMTP sink, then use
# EMAIL_HOST=localhost / EMAIL_PORT=2525 / EMAIL_SECURE=false (EMAIL_REQUIRE_TLS unset).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Sai Krishna Hostel <no-reply@staynest.in>

# Print the OTP to the server console (dev/testing only — set false in production).
EMAIL_LOG_OTP=true

# -- Password reset OTP settings ------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30